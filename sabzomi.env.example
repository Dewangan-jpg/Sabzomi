# ===== Sabzomi settings =====
# 1) Copy this file and name the copy exactly:  sabzomi.env   (same folder as app.py)
# 2) Replace every value below. Lines starting with # are notes. NEVER share this file.

SABZOMI_ENV=production
SABZOMI_SECRET=CHANGE-ME-type-40-or-more-random-letters-and-numbers
SABZOMI_GATEWAY_SECRET=CHANGE-ME-another-40-random-letters-and-numbers

# Keep the database and photos OUTSIDE public_html (replace YOUR_CPANEL_USERNAME)
SABZOMI_DB=/home/YOUR_CPANEL_USERNAME/sabzomi_data/sabzomi.db
SABZOMI_UPLOADS=/home/YOUR_CPANEL_USERNAME/sabzomi_data/uploads

SITE_URL=https://www.yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
FORCE_HTTPS=1

# First admin account (created automatically on first start). DELETE the ADMIN_PASSWORD line after your first login.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=choose-a-strong-password
SEED_SAMPLE=0

# Payments (Razorpay). Use TEST keys first, switch to LIVE keys when ready.
SABZOMI_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Email for password-reset links (create an email account in cPanel first)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=email-account-password
SMTP_FROM=Sabzomi <no-reply@yourdomain.com>

# Never add: SABZOMI_DEV_PAYMENTS (development only)
